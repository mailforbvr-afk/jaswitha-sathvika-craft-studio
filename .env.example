# Copy this file to .env.local and fill in your own values.
# Never commit real keys or phone numbers.

# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Parent/guardian WhatsApp number with country code, digits only.
# Example for India: 9198XXXXXXXX
# Do not put a child's personal number here.
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Optional. Set to true only while designing the site without a database.
# Leave false (or omit) once real products exist in Supabase.
NEXT_PUBLIC_USE_DEMO_DATA=false

# Server-only commerce secrets. Set these in Cloudflare Worker Secrets, never
# with a NEXT_PUBLIC_ prefix and never in browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_TEST_MODE=true
